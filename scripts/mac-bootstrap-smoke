#!/usr/bin/env sh
set -eu
cd "$(dirname "$0")/.."
cargo test --test mac_bootstrap
SMOKE_ROOT=$(mktemp -d)
trap 'rm -rf "$SMOKE_ROOT"' EXIT
HOME_DIR="$SMOKE_ROOT/home&escaped"
FAKE_BIN="$SMOKE_ROOT/bin"
SMOKE_LOG="$SMOKE_ROOT/commands.log"
export SMOKE_LOG
mkdir -p "$HOME_DIR" "$FAKE_BIN"

cat >"$FAKE_BIN/cargo" <<'EOF'
#!/usr/bin/env sh
exit 0
EOF
cat >"$FAKE_BIN/install" <<'EOF'
#!/usr/bin/env sh
shift 2
shift
DEST=$1
cat >"$DEST" <<'PROGRAM'
#!/usr/bin/env sh
case "$0" in
  *mesh-cli)
    test "$1" = doctor
    test "$2" = --identity
    case "$3" in /*) ;; *) exit 1 ;; esac
    printf 'doctor %s\n' "$3" >>"$SMOKE_LOG"
    printf '{"schema_version":1,"checks":[]}\n'
    ;;
  *mesh-agent)
    test "$1" = pair
    test "$2" = --address
    test "$3" = 127.0.0.1:7445
    test "$4" = --identity
    case "$5" in /*) ;; *) exit 1 ;; esac
    printf 'pair %s %s\n' "$3" "$5" >>"$SMOKE_LOG"
    ;;
esac
PROGRAM
chmod 700 "$DEST"
EOF
cat >"$FAKE_BIN/launchctl" <<'EOF'
#!/usr/bin/env sh
printf '%s\n' "$*" >>"$SMOKE_LOG"
case "$1" in
  bootstrap)
    test "$2" = "gui/$(id -u)"
    test -f "$3"
    ;;
  kickstart) test "$2" = -k ;;
  print) printf 'state=running token=smoke-secret\n' ;;
  bootout) ;;
  *) exit 1 ;;
esac
EOF
chmod 700 "$FAKE_BIN/cargo" "$FAKE_BIN/install" "$FAKE_BIN/launchctl"

OUTPUT=$(PATH="$FAKE_BIN:$PATH" sh scripts/setup-mac.sh --dry-run --home "$HOME_DIR")
test "$(printf '%s\n' "$OUTPUT" | wc -l | tr -d ' ')" = 2
test ! -e "$HOME_DIR/Library/LaunchAgents"

OUTPUT=$(PATH="$FAKE_BIN:$PATH" sh scripts/setup-mac.sh --home "$HOME_DIR")
test "$(printf '%s\n' "$OUTPUT" | wc -l | tr -d ' ')" = 2
touch "$HOME_DIR/Library/Application Support/DeviceDevelopmentMesh/identity/idempotent"
for ARGUMENTS in "--upgrade" "--pair-address 127.0.0.1:7445"; do
    OUTPUT=$(PATH="$FAKE_BIN:$PATH" sh scripts/setup-mac.sh $ARGUMENTS --home "$HOME_DIR")
    test "$(printf '%s\n' "$OUTPUT" | wc -l | tr -d ' ')" = 2
    test -e "$HOME_DIR/Library/Application Support/DeviceDevelopmentMesh/identity/idempotent"
done

PLIST="$HOME_DIR/Library/LaunchAgents/dev.mesh.agent.plist"
DIAGNOSTICS="$HOME_DIR/Library/Logs/DeviceDevelopmentMesh/diagnostics"
test -f "$PLIST"
grep -q '<key>KeepAlive</key>' "$PLIST"
grep -q '<key>ThrottleInterval</key>' "$PLIST"
grep -q '&amp;escaped' "$PLIST"
test "$(stat -f %Lp "$PLIST")" = 600
test "$(stat -f %Lp "$HOME_DIR/Library/Application Support/DeviceDevelopmentMesh/identity")" = 700
test "$(PATH="$FAKE_BIN:$PATH" sh scripts/setup-mac.sh --status --home "$HOME_DIR")" = "state=running token=smoke-secret"
grep -q 'token=\[REDACTED\]' "$DIAGNOSTICS/status.txt"
! grep -Eiq 'pairing_code|private_key|signing_secret|smoke-secret' "$PLIST" "$DIAGNOSTICS"/*
test "$(grep -c '^doctor ' "$SMOKE_LOG")" = 3
test "$(grep -c '^pair ' "$SMOKE_LOG")" = 1
test "$(grep -c '^bootstrap ' "$SMOKE_LOG")" = 3
test "$(grep -c '^kickstart ' "$SMOKE_LOG")" = 3

touch "$HOME_DIR/Library/Application Support/DeviceDevelopmentMesh/identity/preserve"
touch "$HOME_DIR/Library/Application Support/DeviceDevelopmentMesh/audit/preserve"
PATH="$FAKE_BIN:$PATH" sh scripts/setup-mac.sh --uninstall --home "$HOME_DIR"
test ! -e "$PLIST"
test ! -e "$HOME_DIR/.local/lib/device-development-mesh/bin/mesh-agent"
test -e "$HOME_DIR/Library/Application Support/DeviceDevelopmentMesh/identity/preserve"
test -e "$HOME_DIR/Library/Application Support/DeviceDevelopmentMesh/audit/preserve"
