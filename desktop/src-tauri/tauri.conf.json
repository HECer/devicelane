{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeviceLane",
  "version": "0.1.0",
  "identifier": "com.hecer.devicelane",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [{ "label": "main", "title": "DeviceLane", "width": 1120, "height": 760, "minWidth": 375, "minHeight": 620 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": "all", "icon": [] }
}
