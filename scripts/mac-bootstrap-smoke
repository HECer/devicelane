#!/usr/bin/env sh
set -eu
cd "$(dirname "$0")/.."
cargo test --test mac_bootstrap
SMOKE_ROOT=$(mktemp -d)
trap 'rm -rf "$SMOKE_ROOT"' EXIT
HOME_DIR="$SMOKE_ROOT/home&escaped"
FAKE_BIN="$SMOKE_ROOT/bin"
SMOKE_LOG="$SMOKE_ROOT/commands.log"
export SMOKE_LOG FAKE_BIN
mkdir -p "$HOME_DIR" "$FAKE_BIN"

cat >"$FAKE_BIN/cargo" <<'EOF'
#!/usr/bin/env sh
exit 0
EOF
cat >"$FAKE_BIN/xcrun" <<'EOF'
#!/usr/bin/env sh
test "$1" = --find
test -n "$2"
printf '%s/%s\n' "$(dirname "$0")" "$2"
EOF
cat >"$FAKE_BIN/plutil" <<'EOF'
#!/usr/bin/env sh
test "$1" = -lint
test -f "$2"
EOF
for APPLE_TOOL in xcodebuild devicectl simctl xcresulttool xctrace lldb-dap; do
    cat >"$FAKE_BIN/$APPLE_TOOL" <<'EOF'
#!/usr/bin/env sh
exit 0
EOF
    chmod 700 "$FAKE_BIN/$APPLE_TOOL"
done
cat >"$FAKE_BIN/install" <<'EOF'
#!/usr/bin/env sh
shift 2
shift
DEST=$1
cat >"$DEST" <<'PROGRAM'
#!/usr/bin/env sh
case "$0" in
  *mesh-cli)
    if [ "$1" = validate-launch-agent ]; then
      test "$2" = --plist
      test -f "$3"
      test "$4" = --controller-host
      test "$5" = 192.0.2.10
      test "$6" = --developer-dir
      test "$7" = "$FAKE_BIN"
      ! grep -q '\$PLIST_' "$3"
      ! grep -q 'process.start@1\|none:ios:disconnected' "$3"
      exit 0
    fi
    test "$1" = doctor
    test "$2" = --identity
    case "$3" in /*) ;; *) exit 1 ;; esac
    printf 'doctor %s\n' "$3" >>"$SMOKE_LOG"
    printf '{"schema_version":1,"checks":[]}\n'
    ;;
  *mesh-agent)
    if [ "$1" = peer-id ]; then
      test "$2" = --identity
      test "$4" = --peer-id
      if [ -f "$3/legacy-peer" ]; then
        printf 'agent\n'
      else
        printf '%s\n' "$5"
      fi
      exit 0
    fi
    test "$1" = pair
    test "$2" = --address
    test "$3" = 192.0.2.10:7445
    test "$4" = --identity
    case "$5" in /*) ;; *) exit 1 ;; esac
    test "$6" = --peer-id
    case "$7" in mac-agent-*) ;; *) exit 1 ;; esac
    printf 'pair %s %s\n' "$3" "$5" >>"$SMOKE_LOG"
    mkdir -p "$5/trust"
    : >"$5/trust/registry.der"
    ;;
esac
PROGRAM
chmod 700 "$DEST"
EOF
cat >"$FAKE_BIN/launchctl" <<'EOF'
#!/usr/bin/env sh
printf '%s\n' "$*" >>"$SMOKE_LOG"
case "$1" in
  bootstrap)
    test "$2" = "gui/$(id -u)"
    test -f "$3"
    ;;
  kickstart) test "$2" = -k ;;
  print) printf 'state=running token=smoke-secret\n' ;;
  bootout) ;;
  *) exit 1 ;;
esac
EOF
chmod 700 "$FAKE_BIN/cargo" "$FAKE_BIN/xcrun" "$FAKE_BIN/plutil" "$FAKE_BIN/install" "$FAKE_BIN/launchctl"

OUTPUT=$(PATH="$FAKE_BIN:$PATH" sh scripts/setup-mac.sh --dry-run --controller 192.0.2.10 --home "$HOME_DIR")
test "$(printf '%s\n' "$OUTPUT" | wc -l | tr -d ' ')" = 2
test ! -e "$HOME_DIR/Library/LaunchAgents"

OUTPUT=$(PATH="$FAKE_BIN:$PATH" MESH_BOOTSTRAP_TEST_MODE=1 MESH_PEER_ID=mac-agent-smoke MESH_XCRUN="$FAKE_BIN/xcrun" MESH_PLUTIL="$FAKE_BIN/plutil" MESH_DEVELOPER_DIR="$FAKE_BIN" sh scripts/setup-mac.sh --controller 192.0.2.10 --home "$HOME_DIR")
test "$(printf '%s\n' "$OUTPUT" | wc -l | tr -d ' ')" = 2
touch "$HOME_DIR/Library/Application Support/DeviceDevelopmentMesh/identity/idempotent"
for ARGUMENTS in "--upgrade" "--pair-address 192.0.2.10:7445"; do
    OUTPUT=$(PATH="$FAKE_BIN:$PATH" MESH_BOOTSTRAP_TEST_MODE=1 MESH_PEER_ID=mac-agent-smoke MESH_XCRUN="$FAKE_BIN/xcrun" MESH_PLUTIL="$FAKE_BIN/plutil" MESH_DEVELOPER_DIR="$FAKE_BIN" sh scripts/setup-mac.sh $ARGUMENTS --controller 192.0.2.10 --home "$HOME_DIR")
    test "$(printf '%s\n' "$OUTPUT" | wc -l | tr -d ' ')" = 2
    test -e "$HOME_DIR/Library/Application Support/DeviceDevelopmentMesh/identity/idempotent"
done

LEGACY_HOME="$SMOKE_ROOT/legacy-home"
mkdir -p "$LEGACY_HOME/Library/Application Support/DeviceDevelopmentMesh/identity/trust"
touch "$LEGACY_HOME/Library/Application Support/DeviceDevelopmentMesh/identity/legacy-peer"
touch "$LEGACY_HOME/Library/Application Support/DeviceDevelopmentMesh/identity/trust/registry.der"
OUTPUT=$(PATH="$FAKE_BIN:$PATH" MESH_BOOTSTRAP_TEST_MODE=1 MESH_PEER_ID=mac-agent-migrated MESH_XCRUN="$FAKE_BIN/xcrun" MESH_PLUTIL="$FAKE_BIN/plutil" MESH_DEVELOPER_DIR="$FAKE_BIN" sh scripts/setup-mac.sh --upgrade --controller 192.0.2.10 --home "$LEGACY_HOME")
test "$(printf '%s\n' "$OUTPUT" | wc -l | tr -d ' ')" = 2
test "$(cat "$LEGACY_HOME/Library/Application Support/DeviceDevelopmentMesh/identity/peer-id")" = mac-agent-migrated
find "$LEGACY_HOME/Library/Application Support/DeviceDevelopmentMesh" -maxdepth 1 -type d -name 'identity.legacy-*' | grep -q .

PLIST="$HOME_DIR/Library/LaunchAgents/dev.mesh.agent.plist"
DIAGNOSTICS="$HOME_DIR/Library/Logs/DeviceDevelopmentMesh/diagnostics"
test -f "$PLIST"
grep -q '<key>KeepAlive</key>' "$PLIST"
grep -q '<key>ThrottleInterval</key>' "$PLIST"
grep -q '&amp;escaped' "$PLIST"
grep -q '<string>192.0.2.10:7443</string>' "$PLIST"
grep -q '<string>--lldb-dap</string>' "$PLIST"
! grep -q 'none:ios:disconnected' "$PLIST"
! grep -q 'process.start@1' "$PLIST"
if [ "$(uname -s)" = Darwin ]; then
    test "$(stat -f %Lp "$PLIST")" = 600
    test "$(stat -f %Lp "$HOME_DIR/Library/Application Support/DeviceDevelopmentMesh/identity")" = 700
fi
test "$(PATH="$FAKE_BIN:$PATH" sh scripts/setup-mac.sh --status --home "$HOME_DIR")" = "state=running token=smoke-secret"
grep -q 'token=\[REDACTED\]' "$DIAGNOSTICS/status.txt"
! grep -Eiq 'pairing_code|private_key|signing_secret|smoke-secret' "$PLIST" "$DIAGNOSTICS"/*
test "$(grep -c '^doctor ' "$SMOKE_LOG")" = 4
test "$(grep -c '^pair ' "$SMOKE_LOG")" = 2
test "$(grep -c '^bootstrap ' "$SMOKE_LOG")" = 4
test "$(grep -c '^kickstart ' "$SMOKE_LOG")" = 4

touch "$HOME_DIR/Library/Application Support/DeviceDevelopmentMesh/identity/preserve"
touch "$HOME_DIR/Library/Application Support/DeviceDevelopmentMesh/audit/preserve"
PATH="$FAKE_BIN:$PATH" sh scripts/setup-mac.sh --uninstall --home "$HOME_DIR"
test ! -e "$PLIST"
test ! -e "$HOME_DIR/.local/lib/device-development-mesh/bin/mesh-agent"
test -e "$HOME_DIR/Library/Application Support/DeviceDevelopmentMesh/identity/preserve"
test -e "$HOME_DIR/Library/Application Support/DeviceDevelopmentMesh/audit/preserve"
